# Dependencias
node_modules/

# Base de datos (no subir datos reales)
database/*.db
database/*.db-shm
database/*.db-wal
database/*.backup-*
backups/

# Imágenes subidas por usuarios
uploads/

# Variables de entorno locales (tokens, secretos — nunca subir)
.env

# Configuración local de Claude Code
.claude/settings.local.json

# Archivos temporales de Windows / macOS
Thumbs.db
.DS_Store

# Recursos temporales de branding Atlas
frontend/fonts/*.zip

# Fuentes locales no distribuidas
frontend/fonts/brimborion/
frontend/fonts/salvador/
